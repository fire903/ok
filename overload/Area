
#include <iostream>
using namespace std;

class Area {
public:
    void calculate(float r) {
        cout << "Area of circle = " << 3.14f * r * r << endl;
    }

    void calculate(float l, float b) {
        cout << "Area of rectangle = " << l * b << endl;
    }

    void calculate(float b, float h, int x) {
        cout << "Area of triangle = " << 0.5f * b * h << endl;
    }
};

int main() {
    Area a;

    a.calculate(5.0f);
    a.calculate(4.0f, 6.0f);
    a.calculate(4.0f, 5.0f, 1);

    return 0;
}
