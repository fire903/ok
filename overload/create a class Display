
#include <iostream>
using namespace std;

class Display {
public:
    void show(int a) {
        cout << "Integer = " << a << endl;
    }

    void show(float b) {
        cout << "Float = " << b << endl;
    }

    void show(string s) {
        cout << "String = " << s << endl;
    }
};

int main() {
    Display d;

    d.show(10);
    d.show(5.5f);
    d.show("Hello");

    return 0;
}
