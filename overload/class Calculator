
#include <iostream>
using namespace std;

class Calculator {
public:
    void multiply(int a, int b) {
        cout << "Product = " << a * b << endl;
    }

    void multiply(int a, int b, int c) {
        cout << "Product = " << a * b * c << endl;
    }

    void multiply(float a, float b) {
        cout << "Product = " << a * b << endl;
    }
};

int main() {
    Calculator c;

    c.multiply(2, 3);
    c.multiply(2, 3, 4);
    c.multiply(2.5f, 4.0f);

    return 0;
}
