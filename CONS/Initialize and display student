#include <iostream>
using namespace std;

class Student {
    string name;
    int roll;

public:
    Student(string n, int r) {
        name = n;
        roll = r;
    }

    void display() {
        cout << "Name: " << name << endl;
        cout << "Roll Number: " << roll << endl;
    }
};

int main() {
    Student s("Aman", 10);
    s.display();

    return 0;
}
