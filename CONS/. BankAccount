#include <iostream>
using namespace std;

class BankAccount {
    string name, type;
    int accno;
    float balance;

public:
    BankAccount() {
        name = "Unknown";
        accno = 0;
        type = "Savings";
        balance = 0;
    }

    BankAccount(string n, int a, string t = "Savings",
                float b = 1000) {
        name = n;
        accno = a;
        type = t;
        balance = b;
    }

    void withdraw(float amount) {
        if (amount <= balance && amount > 0) {
            balance = balance - amount;
            cout << "Withdrawal successful" << endl;
        } else {
            cout << "Insufficient balance or invalid amount"
                 << endl;
        }
    }

    void display() {
        cout << "Name: " << name << endl;
        cout << "Account Number: " << accno << endl;
        cout << "Account Type: " << type << endl;
        cout << "Balance: " << balance << endl;
    }
};

int main() {
    BankAccount b("Rahul", 101, "Savings", 5000);

    b.withdraw(1500);
    b.display();

    return 0;
}
