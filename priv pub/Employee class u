#include <iostream>
using namespace std;

class Employee {
private:
    int id;
    float salary;

protected:
    string department;

public:
    void accept() {
        cout << "Enter employee ID: ";
        cin >> id;

        cout << "Enter salary: ";
        cin >> salary;

        cout << "Enter department: ";
        cin >> department;
    }

    void display() {
        cout << "Employee ID: " << id << endl;
        cout << "Salary: " << salary << endl;
        cout << "Department: " << department << endl;
    }
};

int main() {
    Employee e;

    e.accept();
    e.display();

    return 0;
}
