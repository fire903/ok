
#include <iostream>
using namespace std;

class Shape {
public:
    virtual void calculateArea() {
        cout << "Area of shape" << endl;
    }
};

class Circle : public Shape {
public:
    float radius;

    void calculateArea() {
        cout << "Area of Circle: "
             << 3.14 * radius * radius << endl;
    }
};

class Rectangle : public Shape {
public:
    float length, breadth;

    void calculateArea() {
        cout << "Area of Rectangle: "
             << length * breadth << endl;
    }
};

int main() {
    Circle c;
    Rectangle r;

    c.radius = 5;

    r.length = 10;
    r.breadth = 4;

    Shape *s;

    s = &c;
    s->calculateArea();

    s = &r;
    s->calculateArea();

    return 0;
}
