#include <iostream>
using namespace std;

int main() {
    int num;

    cout << "Enter a number: ";
    cin >> num;

    try {
        if (num < 0) {
            throw num;
        }

        cout << "Positive number or zero";
    }
    catch (int x) {
        cout << "Error: Negative number entered";
    }

    return 0;
}
