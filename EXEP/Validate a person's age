#include <iostream>
using namespace std;

int main() {
    int age;

    cout << "Enter age: ";
    cin >> age;

    try {
        if (age < 18 || age > 120) {
            throw age;
        }

        cout << "Valid age";
    }
    catch (int x) {
        cout << "Error: Invalid age";
    }

    return 0;
}
