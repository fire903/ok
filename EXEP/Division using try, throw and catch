#include <iostream>
using namespace std;

int main() {
    int a, b;

    cout << "Enter two integers: ";
    cin >> a >> b;

    try {
        if (b == 0) {
            throw b;
        }

        cout << "Result: " << a / b;
    }
    catch (int x) {
        cout << "Error: Cannot divide by zero";
    }

    return 0;
}
